# Data is never committed. It is downloaded by scripts/download_data.py and the
# licence and attribution for it live in the README.
data/*
!data/.gitkeep
!data/README.md

# Results are regenerated by scripts/run_ladder.py. The committed exception is the
# small summary tables and figures the README and case study cite, under results/published/.
results/*
!results/.gitkeep
!results/published/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
lightning_logs/
*.ckpt
.DS_Store
